# Finnhub free-tier API key — https://finnhub.io/dashboard
# Server-only. Never prefix with NEXT_PUBLIC_.
# Without it the equity panels fall back to a simulated feed.
FINNHUB_API_KEY=

# --- agent layer ---
# `ollama` runs a local model; nothing leaves the machine and nothing is billed.
# This is the default on purpose: forgetting to set it should never be the
# thing that starts a bill.
AGENT_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# To run the floor on Claude instead, set both of these. The hourly cap on the
# Profile page is what stops a loop here from being expensive.
#   AGENT_PROVIDER=claude
#   ANTHROPIC_API_KEY=
# Optional; defaults to claude-opus-4-8.
#   AGENT_MODEL=claude-opus-4-8

# Agent accountability log.
#   pnpm db:up   starts a local Postgres in Docker
# Point it at Neon or Supabase to persist beyond this machine.
DATABASE_URL=postgres://kairox:kairox@localhost:5432/kairox
